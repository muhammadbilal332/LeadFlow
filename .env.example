# ===========================================
# LeadFlow environment variables
# Copy this file to .env and fill in real values.
# Never commit the real .env file.
# ===========================================

# --- Server ---
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Public origin of the deployed app. Used to build shareable links: public
# lead-capture form URLs, embed snippets, and the webhook URL shown in
# Settings -> Integrations. Falls back to CLIENT_URL if left blank.
PUBLIC_APP_URL=http://localhost:5173

# --- Database (Supabase PostgreSQL) ---
# Get this from Supabase: Project Settings -> Database -> Connection string (URI)
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leadflow

# --- Auth ---
# Generate a strong random secret, e.g. `openssl rand -base64 48`
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- AI Qualification ---
# One of: openai | anthropic | none
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Meta (Facebook/Instagram) Lead Ads integration ---
# Only needed to receive real Meta lead-ad webhooks. See docs/INTEGRATIONS.md
# for the full setup (App Review, webhook subscription, Page Access Token).
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# --- Webhook/integration secret encryption ---
# Used to encrypt any third-party access tokens LeadFlow stores at rest
# (e.g. a Meta Page Access Token). Generate with `openssl rand -hex 32`.
# If left blank, tokens are simply not stored (features that need them stay
# in their "not configured" state rather than storing a token in plaintext).
WEBHOOK_ENCRYPTION_KEY=

# ===========================================================
# Outreach (outbound email automation) — provider switches.
# Every one of these defaults to "mock", which runs the ENTIRE pipeline
# (personalization, sending, delivery, replies) with realistic simulated
# behavior and zero cost or external calls. See docs/OUTREACH.md.
#
# To go live with a real provider, set the *_PROVIDER var below and add its
# credentials — no code changes are needed either way.
# ===========================================================
EMAIL_PROVIDER=mock
EMAIL_PLAN=free
# Separate from AI_PROVIDER above (which powers lead qualification) so the
# two features can never interfere with each other.
OUTREACH_AI_PROVIDER=mock
SHEETS_PROVIDER=mock
INBOUND_PROVIDER=mock
OUTREACH_DAILY_SEND_LIMIT=100

# Real email sending + inbound replies via Resend (https://resend.com — has
# a genuine free tier). Only used when EMAIL_PROVIDER=resend /
# INBOUND_PROVIDER=resend.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Real email sending via Brevo (https://brevo.com — free tier, 300/day, no
# card required). Only used when EMAIL_PROVIDER=brevo.
BREVO_API_KEY=
BREVO_WEBHOOK_SECRET=

# Real Google Sheets import via the free Sheets API v4 (a simple API key,
# not OAuth — works against any sheet shared as "anyone with the link can
# view"). Only used when SHEETS_PROVIDER=google.
GOOGLE_API_KEY=
# Reserved for a future private-sheet OAuth flow — not wired up yet.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# n8n calls back into LeadFlow (POST /api/outreach/tick with a LeadFlow API
# key) to advance the outreach pipeline on a schedule — LeadFlow remains the
# source of truth. This URL is only used if you also want LeadFlow to notify
# an n8n workflow of events; it is not required for the tick flow itself.
N8N_WEBHOOK_URL=

# --- Developer/Admin Dashboard ---
# Provisions a platform-level account (role=developer) once, at server
# startup, if both are set and no user with this email exists yet. Leave
# blank to disable the dashboard entirely. See docs/DEVELOPER_DASHBOARD.md.
# Never commit a real password here.
DEVELOPER_EMAIL=
DEVELOPER_PASSWORD=

# --- Frontend (Vite, exposed to browser - no secrets here) ---
VITE_API_URL=http://localhost:4000/api
